            <div class="col-6">
                <label class="text-muted d-block">Job Number</label>
                <span class="fw-bold fs-6" id="recDrawerJob">--</span>
            </div>
            <div class="col-6">
                <label class="text-muted d-block">PO Number</label>
                <span class="fw-bold fs-6 font-monospace" id="recDrawerPo">--</span>
            </div>
            <div class="col-6">
                <label class="text-muted d-block">Packing Slip #</label>
                <span class="badge bg-light text-dark border font-monospace" id="recDrawerSlip">--</span>
            </div>
            <div class="col-6">
                <label class="text-muted d-block">BOL #</label>
                <span class="font-monospace fw-semibold" id="recDrawerBol">--</span>
            </div>
            <div class="col-6">
                <label class="text-muted d-block">Load Type</label>
                <span class="badge bg-secondary-subtle text-dark" id="recDrawerLoadType">--</span>
            </div>
            <div class="col-6">
                <label class="text-muted d-block">Package Count</label>
                <span class="fw-bold" id="recDrawerPackages">--</span>
            </div>
            <div class="col-6">
                <label class="text-muted d-block">Arrived in Yard</label>
                <span class="fw-semibold text-dark" id="recDrawerArrival">--</span>
            </div>
            <div class="col-6">
                <label class="text-muted d-block">Receiving Status</label>
                <span class="badge bg-warning-subtle text-dark" id="recDrawerStatus">--</span>
            </div>

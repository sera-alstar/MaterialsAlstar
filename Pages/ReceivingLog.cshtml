        var suggestedHts = (catEntry && catEntry.heatNumbers && catEntry.heatNumbers.length > 0)
            ? catEntry.heatNumbers
            : (window.inventoryAutocomplete ? window.inventoryAutocomplete.heatNumbers.slice(0, 3) : []);

        var htChipsHtml = '';
        if (suggestedHts && suggestedHts.length > 0) {
            htChipsHtml = '<div class="mt-1 d-flex flex-wrap gap-1 align-items-center" style="font-size: 10px;">' +
                '<span class="text-muted" style="font-size: 9.5px;">Prev:</span>' +
                suggestedHts.slice(0, 2).map(function(ht) {
                    var safeHt = escapeHtml(ht).replace(/'/g, "\\'");
                    return '<span class="insp-chip-pill" role="button" onclick="autofillField(' + idx + ', \'heatNumber\', \'' + safeHt + '\')" title="Autofill HT#">' + escapeHtml(ht) + '</span>';

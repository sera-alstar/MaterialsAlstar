                if (tbody) {
                    tbody.innerHTML = '<tr><td colspan="10" class="text-center py-4 text-danger">' +
                        '<i class="bi bi-exclamation-triangle-fill me-2"></i>Failed to load VISTA BOM data. Please try again.</td></tr>';
                }
                if (cardsList) {
                    cardsList.innerHTML = '<div class="text-center py-4 text-danger">' +
                        '<i class="bi bi-exclamation-triangle-fill me-2"></i>Failed to load VISTA BOM data. Please try again.</div>';
                }
            });
    }

    function renderInspectionLines() {
        var tbody = document.getElementById('inspectionLinesTbody');
        var cardsList = document.getElementById('inspectionLinesCardsList');
        if (!window.currentInspectionLines) return;

        var query = (document.getElementById('inspLineSearch')?.value || '').toLowerCase().trim();
        var showFullyReceived = document.getElementById('inspToggleFullyReceived')?.checked || false;

        var hiddenFullyCount = 0;
        var tableHtml = '';
        var cardsHtml = '';

        window.currentInspectionLines.forEach(function(line, idx) {
            var ord = parseFloat(line.quantityOrdered) || 0;
            var prev = parseFloat(line.quantityPreviouslyReceived) || 0;
            var isFullyReceived = ord > 0 && prev >= ord;

            if (isFullyReceived) {
                hiddenFullyCount++;
                if (!showFullyReceived) {
                    return; // Skip rendering hidden fully received line by default
                }
            }

            if (query) {
                var desc = (line.itemDescription || '').toLowerCase();
                var bom = (line.bomId || '').toLowerCase();
                var poLine = (line.poLineNumber || '').toLowerCase();
                var ht = (line.heatNumber || '').toLowerCase();
                var loc = (line.storageLocation || '').toLowerCase();

                if (!desc.includes(query) && !bom.includes(query) && !poLine.includes(query) && !ht.includes(query) && !loc.includes(query)) {
                    return;
                }
            }

            tableHtml += buildInspectionRowHtml(line, idx, isFullyReceived);
            cardsHtml += buildInspectionCardHtml(line, idx, isFullyReceived);
        });

        var hiddenCountEl = document.getElementById('inspFullyRecHiddenCount');
        if (hiddenCountEl) hiddenCountEl.innerText = hiddenFullyCount;

        var emptyMsg = '<div class="text-center py-4 text-muted">' +
            '<i class="bi bi-funnel me-1"></i>No matching lines found. ' +
            (hiddenFullyCount > 0 && !showFullyReceived ? '<a href="javascript:void(0)" class="fw-semibold text-primary" onclick="document.getElementById(\'inspToggleFullyReceived\').click()">Show ' + hiddenFullyCount + ' fully received line(s)</a>' : '') +
            '</div>';

        if (tbody) {
            if (tableHtml === '') {
                tbody.innerHTML = '<tr><td colspan="10" class="text-center py-4 text-muted">' +
                    '<i class="bi bi-funnel me-1"></i>No matching lines found. ' +
                    (hiddenFullyCount > 0 && !showFullyReceived ? '<a href="javascript:void(0)" class="fw-semibold text-primary" onclick="document.getElementById(\'inspToggleFullyReceived\').click()">Show ' + hiddenFullyCount + ' fully received line(s)</a>' : '') +
                    '</td></tr>';
            } else {
                tbody.innerHTML = tableHtml;
            }
        }

        if (cardsList) {
            if (cardsHtml === '') {
                cardsList.innerHTML = emptyMsg;
            } else {
                cardsList.innerHTML = cardsHtml;
            }
        }

        updateSummaryMetrics();
    }

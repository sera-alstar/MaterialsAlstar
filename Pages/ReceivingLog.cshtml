    function buildInspectionRowHtml(line, idx, isFullyReceived) {
        var bomKey = (line.bomId || '').trim().toLowerCase();
        var catEntry = window.inventoryAutocomplete && window.inventoryAutocomplete.catalog ? window.inventoryAutocomplete.catalog[bomKey] : null;


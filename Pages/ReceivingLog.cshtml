    function openInspectionModal(entryId, jpKey, poNumber, vendorName, receiverName) {
        window.currentInspectionEntryId = entryId;

        var modalEl = document.getElementById('inspectionModal');
        if (!window.inspectionModalInstance) {
            window.inspectionModalInstance = new bootstrap.Modal(modalEl);
        }

        // Auto-select cards on mobile screens (< 992px) or table on wider screens
        var initialMode = window.innerWidth < 992 ? 'cards' : 'table';
        switchInspectionView(initialMode);

        // Set preliminary header values
        document.getElementById('inspModalJpKey').innerText = jpKey || '--';
        document.getElementById('inspModalVendor').innerText = vendorName || '--';
        document.getElementById('inspModalPo').innerText = poNumber || '--';
        document.getElementById('inspSaveBadge').className = 'badge bg-secondary-subtle text-secondary border px-2 py-1 small';
        document.getElementById('inspSaveBadge').innerHTML = '<i class="bi bi-clock me-1"></i> Loading VISTA BOM...';
        document.getElementById('inspLineSearch').value = '';
        document.getElementById('inspToggleFullyReceived').checked = false;

        var tbody = document.getElementById('inspectionLinesTbody');
        if (tbody) {
            tbody.innerHTML = '<tr><td colspan="10" class="text-center py-5 text-muted">' +
                '<div class="spinner-border text-primary spinner-border-sm me-2" role="status"></div>' +
                'Ingesting VISTA BOM lines and Job 251078 inventory autocomplete...</td></tr>';
        }
        var cardsList = document.getElementById('inspectionLinesCardsList');
        if (cardsList) {
            cardsList.innerHTML = '<div class="text-center py-5 text-muted">' +
                '<div class="spinner-border text-primary spinner-border-sm me-2" role="status"></div>' +
                'Ingesting VISTA BOM lines and Job 251078 inventory autocomplete...</div>';
        }

        window.inspectionModalInstance.show();

        // Fetch live inspection data from server
        fetch('/ReceivingLog?handler=InspectionData&entryId=' + entryId + '&receiverName=' + encodeURIComponent(receiverName || ''))
            .then(function(res) {
                if (!res.ok) throw new Error('HTTP ' + res.status);
                return res.json();
            })
            .then(function(data) {
                document.getElementById('inspModalJob').innerText = data.jobNumber || '251078';
                document.getElementById('inspModalSlip').innerText = data.packingSlipNumber || '--';
                document.getElementById('inspModalBol').innerText = data.bolNumber || '--';
                document.getElementById('inspReceiverName').value = data.receiverName || 'SR Inspector';
                document.getElementById('inspYardArrival').innerText = data.arrivalDateTime || '--';
                document.getElementById('inspStartTime').innerText = data.receiveStartTime || '--';
                document.getElementById('inspStaging').innerText = '📍 ' + (data.stagingLocation || 'Walkway');
                document.getElementById('inspOverallNotes').value = data.inspectionNotes || '';

                window.currentInspectionLines = data.lines || [];
                window.inventoryAutocomplete = data.autocomplete || { heatNumbers: [], serialNumbers: [], binLocations: [], catalog: {} };

                // Populate Global Datalists for Autocomplete
                if (window.inventoryAutocomplete) {
                    var dlHt = document.getElementById('dl_all_heat_numbers');
                    var dlSn = document.getElementById('dl_all_serial_numbers');
                    var dlBin = document.getElementById('dl_all_bin_locations');

                    if (dlHt && window.inventoryAutocomplete.heatNumbers) {
                        dlHt.innerHTML = window.inventoryAutocomplete.heatNumbers.map(function(h) {
                            return '<option value="' + escapeHtml(h) + '"></option>';
                        }).join('');
                    }
                    if (dlSn && window.inventoryAutocomplete.serialNumbers) {
                        dlSn.innerHTML = window.inventoryAutocomplete.serialNumbers.map(function(s) {
                            return '<option value="' + escapeHtml(s) + '"></option>';
                        }).join('');
                    }
                    if (dlBin && window.inventoryAutocomplete.binLocations) {
                        dlBin.innerHTML = window.inventoryAutocomplete.binLocations.map(function(b) {
                            return '<option value="' + escapeHtml(b) + '"></option>';
                        }).join('');
                    }
                }

                // Check LocalStorage Draft backup if available
                try {
                    var localKey = 'alstar_insp_draft_' + entryId;
                    var localDraftStr = localStorage.getItem(localKey);
                    if (localDraftStr) {
                        var localDraft = JSON.parse(localDraftStr);
                        if (localDraft && localDraft.lines && localDraft.lines.length === window.currentInspectionLines.length) {
                            window.currentInspectionLines = localDraft.lines;
                            if (localDraft.notes) document.getElementById('inspOverallNotes').value = localDraft.notes;
                            if (localDraft.receiver) document.getElementById('inspReceiverName').value = localDraft.receiver;
                        }
                    }
                } catch (e) {
                    console.warn('Draft restoration notice:', e);
                }

                document.getElementById('inspSaveBadge').className = 'badge bg-success-subtle text-success border px-2 py-1 small';
                document.getElementById('inspSaveBadge').innerHTML = '<i class="bi bi-check-circle me-1"></i> Ready';

                renderInspectionLines();

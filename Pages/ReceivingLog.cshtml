@section Scripts {
<script>
    function openReceivingDrawerFromRow(row) {
        var d = row.dataset;
        document.getElementById('recDrawerEntryId').value = d.id;
        document.getElementById('recDrawerJpKey').innerText = d.jpkey;
        document.getElementById('recDrawerVendor').innerText = d.vendor;
        document.getElementById('recDrawerStaging').innerText = d.staging;
        document.getElementById('recDrawerJob').innerText = d.job;
        document.getElementById('recDrawerPo').innerText = d.po;
        document.getElementById('recDrawerSlip').innerText = d.slip;
        document.getElementById('recDrawerBol').innerText = d.bol;
        document.getElementById('recDrawerLoadType').innerText = d.loadtype;
        document.getElementById('recDrawerPackages').innerText = d.packages;
        document.getElementById('recDrawerArrival').innerText = d.arrival;
        document.getElementById('recDrawerStatus').innerText = d.status;
        document.getElementById('recDrawerNotes').innerText = d.notes || 'No notes specified.';

        // RecLog & QC Details
        document.getElementById('recDrawerMrr').innerText = d.mrr || '--';
        document.getElementById('recDrawerRecId').innerText = d.recid || '--';
        document.getElementById('recDrawerReceiver').innerText = d.receiver || 'Unassigned';
        document.getElementById('recDrawerUnloader').innerText = d.unloader || 'Yard Crew';
        document.getElementById('recDrawerMatMtr').innerText = d.matmtr || '--';
        document.getElementById('recDrawerMatMtrComm').innerText = d.matmtrcomm || '';
        document.getElementById('recDrawerQcMtr').innerText = d.qcmtr || '--';
        document.getElementById('recDrawerQcMtrComm').innerText = d.qcmtrcomm || '';

        var docLinkSection = document.getElementById('recDrawerDocLinkSection');
        if (d.doclink && d.doclink.trim() !== '') {
            document.getElementById('recDrawerDocLink').href = d.doclink;
            docLinkSection.classList.remove('d-none');
        } else {
            docLinkSection.classList.add('d-none');
        }

        var photoSection = document.getElementById('recDrawerPhotoSection');
        if (d.photo && d.photo.trim() !== '') {
            document.getElementById('recDrawerPhotoImg').src = d.photo;
            document.getElementById('recDrawerPhotoLink').href = d.photo;
            photoSection.classList.remove('d-none');
        } else {
            photoSection.classList.add('d-none');
        }

        document.getElementById('recDrawerBackdrop').classList.add('active');
        document.getElementById('recDrawer').style.right = '0';
    }

    function closeReceivingDrawer() {
        document.getElementById('recDrawerBackdrop').classList.remove('active');
        document.getElementById('recDrawer').style.right = '-540px';
    }

    function openAdminVerifyModalFromBtn(btn) {
        var d = btn.dataset;
        document.getElementById('verifyEntryId').value = d.id;
        document.getElementById('verifyPo').innerText = d.po;
        document.getElementById('verifyVendor').innerText = d.vendor;
        document.getElementById('verifySlipBol').innerText = d.slip + ' / ' + d.bol;
        document.getElementById('verifyJobInput').value = d.job || '';
        document.getElementById('verifyLoadTypeInput').value = d.loadtype || 'General Materials';
        document.getElementById('verifyStagingInput').value = d.staging || 'Walkway';

        if (window.resetJobSearchableDropdown) {
            window.resetJobSearchableDropdown(d.job || '');
        }

        var modal = new bootstrap.Modal(document.getElementById('adminVerifyModal'));
        modal.show();
    }

    // Searchable Dropdown for Jobs in Admin Verification Modal
    function initJobSearchableDropdown() {
        var input = document.getElementById('verifyJobInput');
        var toggleBtn = document.getElementById('jobDropdownToggleBtn');
        var menu = document.getElementById('jobDropdownMenu');
        var optionsList = document.getElementById('jobOptionsList');
        var noMatch = document.getElementById('jobNoMatch');
        var matchCount = document.getElementById('jobMatchCount');
        var icon = document.getElementById('jobDropdownIcon');
        var modalEl = document.getElementById('adminVerifyModal');

        if (!input || !menu || !optionsList) return;

        function openDropdown() {
            menu.style.display = 'block';
            if (icon) {
                icon.classList.remove('bi-chevron-down');
                icon.classList.add('bi-chevron-up');
            }
            filterOptions(input.value);
        }

        function closeDropdown() {
            menu.style.display = 'none';
            if (icon) {
                icon.classList.remove('bi-chevron-up');
                icon.classList.add('bi-chevron-down');
            }
            var items = optionsList.querySelectorAll('.job-option-item');
            items.forEach(function(el) { el.classList.remove('active'); });
        }

        function filterOptions(query) {
            var q = (query || '').toLowerCase().trim();
            var items = optionsList.querySelectorAll('.job-option-item');
            var visibleCount = 0;

            items.forEach(function(item) {
                var job = (item.dataset.job || '').toLowerCase();
                var client = (item.dataset.client || '').toLowerCase();
                var isMatch = !q || job.includes(q) || client.includes(q);

                if (isMatch) {
                    item.classList.remove('d-none');
                    visibleCount++;
                } else {
                    item.classList.add('d-none');
                }

                // Show selected checkmark icon if exact match
                var checkIcon = item.querySelector('.job-selected-icon');
                if (checkIcon) {
                    if (q && job === q) {
                        checkIcon.classList.remove('d-none');
                    } else {
                        checkIcon.classList.add('d-none');
                    }
                }
            });

            if (matchCount) matchCount.innerText = visibleCount;
            if (noMatch) {
                if (visibleCount === 0) {
                    noMatch.classList.remove('d-none');
                } else {
                    noMatch.classList.add('d-none');
                }
            }
        }

        function selectJob(jobVal) {
            input.value = jobVal;
            closeDropdown();
            input.dispatchEvent(new Event('change'));
        }

        input.addEventListener('focus', function() {
            openDropdown();
        });

        input.addEventListener('click', function() {
            openDropdown();
        });

        input.addEventListener('input', function() {
            if (menu.style.display !== 'block') {
                openDropdown();
            } else {
                filterOptions(input.value);
            }
        });

        input.addEventListener('keydown', function(e) {
            var visibleItems = Array.from(optionsList.querySelectorAll('.job-option-item:not(.d-none)'));

            if (e.key === 'ArrowDown') {
                e.preventDefault();
                if (menu.style.display !== 'block') {
                    openDropdown();
                    return;
                }
                if (visibleItems.length === 0) return;
                var activeIndex = visibleItems.findIndex(function(it) { return it.classList.contains('active'); });
                var nextIndex = activeIndex < visibleItems.length - 1 ? activeIndex + 1 : 0;
                visibleItems.forEach(function(it) { it.classList.remove('active'); });
                visibleItems[nextIndex].classList.add('active');
                visibleItems[nextIndex].scrollIntoView({ block: 'nearest' });
            } else if (e.key === 'ArrowUp') {
                e.preventDefault();
                if (menu.style.display !== 'block') {
                    openDropdown();
                    return;
                }
                if (visibleItems.length === 0) return;
                var activeIndex = visibleItems.findIndex(function(it) { return it.classList.contains('active'); });
                var prevIndex = activeIndex > 0 ? activeIndex - 1 : visibleItems.length - 1;
                visibleItems.forEach(function(it) { it.classList.remove('active'); });
                visibleItems[prevIndex].classList.add('active');
                visibleItems[prevIndex].scrollIntoView({ block: 'nearest' });
            } else if (e.key === 'Enter') {
                if (menu.style.display === 'block') {
                    var highlighted = visibleItems.find(function(it) { return it.classList.contains('active'); });
                    if (highlighted) {
                        e.preventDefault();
                        selectJob(highlighted.dataset.job);
                    }
                }
            } else if (e.key === 'Escape') {
                closeDropdown();
            }
        });

        if (toggleBtn) {
            toggleBtn.addEventListener('click', function(e) {
                e.stopPropagation();
                if (menu.style.display === 'block') {
                    closeDropdown();
                } else {
                    openDropdown();
                    input.focus();
                }
            });
        }

        optionsList.addEventListener('click', function(e) {
            var item = e.target.closest('.job-option-item');
            if (item) {
                e.preventDefault();
                selectJob(item.dataset.job);
            }
        });

        document.addEventListener('click', function(e) {
            if (!menu.contains(e.target) && !input.contains(e.target) && (!toggleBtn || !toggleBtn.contains(e.target))) {
                closeDropdown();
            }
        });

        if (modalEl) {
            modalEl.addEventListener('hidden.bs.modal', function() {
                closeDropdown();
            });
        }

        window.resetJobSearchableDropdown = function(initialJob) {
            closeDropdown();
            filterOptions(initialJob || '');
        };
    }

    // -------------------------------------------------------------
    // Client-Side Column Sorting for Receiving Log
    // Supports 3-state toggle: Unsorted -> Ascending -> Descending -> Unsorted
    // Columns: PO#, Vendor, Packing Slip#, BOL#, Load Type, Staging, Landed Time, Status
    // -------------------------------------------------------------
    function initTableSorting() {
        var currentSortKey = null;
        var currentSortDir = 'none'; // 'none' | 'asc' | 'desc'

        var sortLabels = {
            'po': 'PO #',
            'vendor': 'Vendor',
            'slip': 'Packing Slip #',
            'bol': 'BOL #',
            'loadtype': 'Load Type',
            'staging': 'Staging Location',
            'arrival': 'Landed Time',
            'status': 'Status'
        };

        // Cache original order indices on all rows across tables
        var tables = document.querySelectorAll('table.hs-table');
        tables.forEach(function(table) {
            var rows = table.querySelectorAll('tbody tr.rec-log-row');
            rows.forEach(function(row, idx) {
                row.dataset.originalIndex = idx;
            });
        });

        function compareRows(a, b, key, dir) {
            if (dir === 'none' || !key) {
                var idxA = parseInt(a.dataset.originalIndex, 10) || 0;
                var idxB = parseInt(b.dataset.originalIndex, 10) || 0;
                return idxA - idxB;
            }

            if (key === 'arrival') {
                var tsA = parseInt(a.dataset.arrivalTs, 10) || 0;
                var tsB = parseInt(b.dataset.arrivalTs, 10) || 0;
                return dir === 'asc' ? (tsA - tsB) : (tsB - tsA);
            }

            var valA = (a.dataset[key] || '').trim();
            var valB = (b.dataset[key] || '').trim();

            // Natural alphanumeric / numerical comparison (e.g. PO numbers, vendors, slip, etc.)
            var cmp = valA.localeCompare(valB, undefined, { numeric: true, sensitivity: 'base' });
            return dir === 'asc' ? cmp : -cmp;
        }

        function updateSortUI() {
            var headers = document.querySelectorAll('th.sortable-col');
            headers.forEach(function(th) {
                var key = th.dataset.sortKey;
                var icon = th.querySelector('.sort-icon');
                var label = sortLabels[key] || key;

                if (key === currentSortKey && currentSortDir !== 'none') {
                    th.classList.add('sorted-active');
                    if (currentSortDir === 'asc') {
                        if (icon) {
                            icon.className = 'bi bi-arrow-up sort-icon text-primary fw-bold ms-1';
                            icon.style.opacity = '1';
                        }
                        th.title = label + ': Sorted ascending (A-Z, 0-9). Click to sort descending.';
                    } else {
                        if (icon) {
                            icon.className = 'bi bi-arrow-down sort-icon text-primary fw-bold ms-1';
                            icon.style.opacity = '1';
                        }
                        th.title = label + ': Sorted descending (Z-A, 9-0). Click to return to unsorted.';
                    }
                } else {
                    th.classList.remove('sorted-active');
                    if (icon) {
                        icon.className = 'bi bi-arrow-down-up sort-icon text-muted opacity-50 ms-1';
                        icon.style.opacity = '';
                    }
                    th.title = 'Click to sort by ' + label + ': Unsorted \u2192 Ascending \u2192 Descending';
                }
            });

            // Update toolbar sort indicator
            var toolbarNotice = document.getElementById('toolbarSortNotice');
            if (toolbarNotice) {
                if (currentSortKey && currentSortDir !== 'none') {
                    var dirText = currentSortDir === 'asc' ? 'Ascending (A &rarr; Z, 0 &rarr; 9)' : 'Descending (Z &rarr; A, 9 &rarr; 0)';
                    var dirIcon = currentSortDir === 'asc' ? 'bi-sort-alpha-down' : 'bi-sort-alpha-down-alt';
                    toolbarNotice.innerHTML = '<span class="badge bg-primary-subtle text-primary border border-primary-subtle me-1"><i class="bi ' + dirIcon + ' me-1"></i>Sorted by: <strong>' + (sortLabels[currentSortKey] || currentSortKey) + '</strong> (' + dirText + ')</span> ' +
                        '<button type="button" class="btn btn-link btn-sm text-danger text-decoration-none p-0 ms-1" onclick="window.resetTableSorting()"><i class="bi bi-x-circle me-1"></i>Reset to default order</button>';
                } else {
                    toolbarNotice.innerHTML = 'Order within groups: <strong class="text-dark">JP Key &rarr; Job # &rarr; Staging Location</strong>';
                }
            }

            // Update group card badges
            var groupBadges = document.querySelectorAll('.group-order-badge');
            groupBadges.forEach(function(badge) {
                if (currentSortKey && currentSortDir !== 'none') {
                    var arrow = currentSortDir === 'asc' ? '\u2191' : '\u2193';
                    badge.className = 'badge bg-primary-subtle text-primary border border-primary-subtle small group-order-badge';
                    badge.innerHTML = '<i class="bi bi-arrow-down-up me-1"></i> Sorted by ' + (sortLabels[currentSortKey] || currentSortKey) + ' ' + arrow;
                } else {
                    badge.className = 'badge bg-secondary-subtle text-secondary border small group-order-badge';
                    badge.innerHTML = '<i class="bi bi-sort-numeric-down me-1"></i> Ordered by JP Key &bull; Job # &bull; Staging';
                }
            });
        }

        function applySorting() {
            var allTables = document.querySelectorAll('table.hs-table');
            allTables.forEach(function(table) {
                var tbody = table.querySelector('tbody');
                if (!tbody) return;
                var rows = Array.from(tbody.querySelectorAll('tr.rec-log-row'));
                if (rows.length <= 1) return;

                rows.sort(function(a, b) {
                    return compareRows(a, b, currentSortKey, currentSortDir);
                });

                var fragment = document.createDocumentFragment();
                rows.forEach(function(row) {
                    fragment.appendChild(row);
                });
                tbody.appendChild(fragment);
            });

            updateSortUI();
        }

        // Click handler for column headers
        document.addEventListener('click', function(e) {
            var th = e.target.closest('th.sortable-col');
            if (!th) return;

            var key = th.dataset.sortKey;
            if (!key) return;

            if (currentSortKey !== key) {
                currentSortKey = key;
                currentSortDir = 'asc';
            } else {
                if (currentSortDir === 'asc') {
                    currentSortDir = 'desc';
                } else if (currentSortDir === 'desc') {
                    currentSortDir = 'none';
                    currentSortKey = null;
                } else {
                    currentSortDir = 'asc';
                }
            }

            applySorting();
        });

        // Expose reset sorting function globally
        window.resetTableSorting = function() {
            currentSortKey = null;
            currentSortDir = 'none';
            applySorting();
        };
    }


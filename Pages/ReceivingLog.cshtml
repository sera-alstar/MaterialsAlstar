    function openAdminReviewModal(entryId, jpKey, poNumber, vendorName, jobNumber) {
        var modalEl = document.getElementById('adminInspectionReviewModal');
        if (!window.adminReviewModalInstance) {
            window.adminReviewModalInstance = new bootstrap.Modal(modalEl);
        }

        document.getElementById('adminRevJpKey').innerText = jpKey || '--';
        document.getElementById('adminRevPo').innerText = poNumber || '--';
        document.getElementById('adminRevJob').innerText = jobNumber || '251078';
        document.getElementById('adminRevVendor').innerText = vendorName || '--';
        document.getElementById('adminApproveEntryId').value = entryId;

        var tbody = document.getElementById('adminRevLinesTbody');
        var cardsList = document.getElementById('adminRevLinesCardsList');
        if (tbody) {
            tbody.innerHTML = '<tr><td colspan="8" class="text-center py-4 text-muted">' +
                '<div class="spinner-border spinner-border-sm text-warning me-2"></div>Loading inspected line items &amp; traceability data...</td></tr>';
        }
        if (cardsList) {
            cardsList.innerHTML = '<div class="text-center py-4 text-muted">' +
                '<div class="spinner-border spinner-border-sm text-warning me-2"></div>Loading inspected line items &amp; traceability data...</div>';
        }

        window.adminReviewModalInstance.show();

        fetch('/ReceivingLog?handler=InspectionData&entryId=' + entryId)
            .then(function(res) {
                if (!res.ok) throw new Error('HTTP ' + res.status);
                return res.json();
            })
            .then(function(data) {
                document.getElementById('adminRevInspector').innerText = data.receiverName || 'Receiver';
                document.getElementById('adminRevArrival').innerText = data.arrivalDateTime || '--';
                document.getElementById('adminRevWindow').innerText = (data.receiveStartTime || '--') + ' to ' + (data.receiveEndTime || '--');
                document.getElementById('adminRevStatus').innerText = data.status || 'Pending Admin Approval';
                document.getElementById('adminRevNotesDisplay').innerText = data.inspectionNotes || 'No specific discrepancies logged.';

                var lines = data.lines || [];
                if (lines.length === 0) {
                    if (tbody) tbody.innerHTML = '<tr><td colspan="8" class="text-center py-4 text-muted">No line item details found for this shipment.</td></tr>';
                    if (cardsList) cardsList.innerHTML = '<div class="text-center py-4 text-muted">No line item details found for this shipment.</div>';
                    return;
                }

                var linesTableHtml = '';
                var linesCardsHtml = '';

                lines.forEach(function(l) {
                    var matchIcon = l.isDescriptionMatched
                        ? '<span class="badge bg-success-subtle text-success border border-success-subtle"><i class="bi bi-check-circle me-1"></i>Matched</span>'
                        : '<span class="badge bg-danger-subtle text-danger border border-danger-subtle"><i class="bi bi-exclamation-triangle me-1"></i>Discrepancy</span>';

                    var recBadge = l.quantityReceivedThisShipment > 0
                        ? '<strong class="text-success font-monospace fs-6">' + l.quantityReceivedThisShipment + '</strong>'
                        : '<span class="text-muted font-monospace">0</span>';

                    // Table Row (Desktop)
                    linesTableHtml += '<tr>' +
                        '<td><span class="fw-bold font-monospace">' + escapeHtml(l.poLineNumber || '--') + '</span><div class="text-muted font-monospace" style="font-size:10.5px;">' + escapeHtml(l.bomId || '--') + '</div></td>' +
                        '<td><span class="fw-semibold">' + escapeHtml(l.itemDescription || '') + '</span></td>' +
                        '<td style="text-align: center;">' + l.quantityOrdered + ' / ' + l.quantityPreviouslyReceived + ' / ' + recBadge + ' ' + escapeHtml(l.unitOfMeasure || 'EA') + '</td>' +
                        '<td style="text-align: center;">' + matchIcon + '</td>' +
                        '<td><span class="badge bg-light text-dark border font-monospace">' + (escapeHtml(l.heatNumber) || '--') + '</span></td>' +
                        '<td><span class="badge bg-light text-dark border font-monospace">' + (escapeHtml(l.serialNumber) || '--') + '</span></td>' +
                        '<td><span class="badge bg-primary-subtle text-primary border border-primary-subtle font-monospace">📍 ' + (escapeHtml(l.storageLocation) || 'Walkway') + '</span></td>' +
                        '<td><span class="small text-muted">' + (escapeHtml(l.notes) || '--') + '</span></td>' +
                    '</tr>';

                    // Card Layout (Mobile)
                    linesCardsHtml += '<div class="card p-3 mb-2 shadow-sm border">' +
                        '<div class="d-flex justify-content-between align-items-center mb-1">' +
                            '<div class="d-flex align-items-center gap-1">' +
                                '<span class="badge bg-secondary font-monospace">Line ' + escapeHtml(l.poLineNumber || '--') + '</span>' +
                                '<span class="badge bg-light text-muted border font-monospace">' + escapeHtml(l.bomId || '--') + '</span>' +
                            '</div>' +
                            matchIcon +
                        '</div>' +
                        '<div class="fw-bold text-dark small mb-2">' + escapeHtml(l.itemDescription || '') + '</div>' +
                        '<div class="row g-2 small bg-light p-2 rounded mb-2 text-center">' +
                            '<div class="col-4 border-end"><strong>Ord:</strong> ' + l.quantityOrdered + '</div>' +
                            '<div class="col-4 border-end"><strong>Prev:</strong> ' + l.quantityPreviouslyReceived + '</div>' +
                            '<div class="col-4"><strong>Rec\'d:</strong> ' + recBadge + ' ' + escapeHtml(l.unitOfMeasure || 'EA') + '</div>' +
                        '</div>' +
                        '<div class="d-flex flex-wrap gap-1 align-items-center font-monospace small mb-1">' +
                            '<span class="badge bg-light text-dark border">HT: ' + (escapeHtml(l.heatNumber) || 'None') + '</span>' +
                            (l.serialNumber ? '<span class="badge bg-light text-dark border">SN: ' + escapeHtml(l.serialNumber) + '</span>' : '') +
                            '<span class="badge bg-primary-subtle text-primary border border-primary-subtle ms-auto">📍 ' + (escapeHtml(l.storageLocation) || 'Walkway') + '</span>' +
                        '</div>' +
                        (l.notes ? '<div class="small text-muted mt-1 fst-italic"><i class="bi bi-chat-left-text me-1"></i>' + escapeHtml(l.notes) + '</div>' : '') +
                    '</div>';
                });

                if (tbody) tbody.innerHTML = linesTableHtml;
                if (cardsList) cardsList.innerHTML = linesCardsHtml;
            })
            .catch(function(err) {
                console.error(err);
                if (tbody) {
                    tbody.innerHTML = '<tr><td colspan="8" class="text-center py-4 text-danger">' +
                        '<i class="bi bi-exclamation-triangle me-2"></i>Failed to load audit data.</td></tr>';
                }
                if (cardsList) {
                    cardsList.innerHTML = '<div class="text-center py-4 text-danger">' +
                        '<i class="bi bi-exclamation-triangle me-2"></i>Failed to load audit data.</div>';
                }
            });
    }

    function submitAdminApproval() {
        var form = document.getElementById('adminApproveForm');
        if (form) {
            form.submit();
        }
    }

    function returnInspectionForRevision() {
        var entryId = document.getElementById('adminApproveEntryId')?.value;
        if (!entryId) return;

        var reason = prompt('Please enter the reason for returning this shipment for revision (e.g. Missing Heat # on line 2):');
        if (reason === null) return; // User pressed Cancel
        if (!reason.trim()) {
            alert('A return reason is required.');
            return;
        }

        var form = document.createElement('form');
        form.method = 'POST';
        form.action = '/ReceivingLog?handler=ReturnInspection';

        var idInput = document.createElement('input');
        idInput.type = 'hidden';
        idInput.name = 'entryId';
        idInput.value = entryId;
        form.appendChild(idInput);

        var reasonInput = document.createElement('input');
        reasonInput.type = 'hidden';
        reasonInput.name = 'returnReason';
        reasonInput.value = reason;
        form.appendChild(reasonInput);

        var token = getAntiForgeryToken();
        if (token) {
            var tokenInput = document.createElement('input');
            tokenInput.type = 'hidden';
            tokenInput.name = '__RequestVerificationToken';
            tokenInput.value = token;
            form.appendChild(tokenInput);
        }

        document.body.appendChild(form);
        form.submit();
    }
</script>
}

    function exportReceivingLogToCsv() {
        var tables = document.querySelectorAll('.hs-table');
        var csv = [];
        csv.push('"JP Key","Job #","PO #","Vendor","Packing Slip","BOL","Packages","Load Type","Staging Location","Landed Time","Status"');

        tables.forEach(function(table) {
            var rows = table.querySelectorAll('tbody tr');
            rows.forEach(function(row) {
                var cols = row.querySelectorAll('td');
                if (cols.length >= 12) {
                    var r = [];
                    // Extract clean text from relevant columns
                    r.push('"' + cols[0].innerText.replace(/(\r\n|\n|\r)/gm, ' ').replace(/"/g, '""').trim() + '"');
                    r.push('"' + cols[1].innerText.replace(/(\r\n|\n|\r)/gm, ' ').replace(/"/g, '""').trim() + '"');
                    r.push('"' + cols[2].innerText.replace(/(\r\n|\n|\r)/gm, ' ').replace(/"/g, '""').trim() + '"');
                    r.push('"' + cols[3].innerText.replace(/(\r\n|\n|\r)/gm, ' ').replace(/"/g, '""').trim() + '"');
                    r.push('"' + cols[4].innerText.replace(/(\r\n|\n|\r)/gm, ' ').replace(/"/g, '""').trim() + '"');
                    r.push('"' + cols[5].innerText.replace(/(\r\n|\n|\r)/gm, ' ').replace(/"/g, '""').trim() + '"');
                    r.push('"' + cols[6].innerText.replace(/(\r\n|\n|\r)/gm, ' ').replace(/"/g, '""').trim() + '"');
                    r.push('"' + cols[7].innerText.replace(/(\r\n|\n|\r)/gm, ' ').replace(/"/g, '""').trim() + '"');
                    r.push('"' + cols[8].innerText.replace(/(\r\n|\n|\r)/gm, ' ').replace(/"/g, '""').trim() + '"');
                    r.push('"' + cols[9].innerText.replace(/(\r\n|\n|\r)/gm, ' ').replace(/"/g, '""').trim() + '"');
                    r.push('"' + cols[11].innerText.replace(/(\r\n|\n|\r)/gm, ' ').replace(/"/g, '""').trim() + '"');
                    csv.push(r.join(','));
                }
            });
        });

        var csvFile = new Blob([csv.join('\n')], { type: 'text/csv' });
        var downloadLink = document.createElement('a');
        downloadLink.download = 'Alstar_Yard_Receiving_Log.csv';
        downloadLink.href = window.URL.createObjectURL(csvFile);
        downloadLink.style.display = 'none';
        document.body.appendChild(downloadLink);
        downloadLink.click();
        document.body.removeChild(downloadLink);
    }

    function escapeHtml(str) {
        if (!str) return '';
        return String(str)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#39;');
    }


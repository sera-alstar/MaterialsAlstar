        <!-- Photo Section -->
        <div id="recDrawerPhotoSection" class="mb-4 d-none">
            <h6 class="text-uppercase text-muted fw-bold small mb-2">Shipment Photo / BOL Capture</h6>
            <div class="p-2 border rounded-2 bg-light text-center">
                <a id="recDrawerPhotoLink" href="#" target="_blank">
                    <img id="recDrawerPhotoImg" src="#" alt="Shipment Photo" class="img-fluid rounded" style="max-height: 220px; object-fit: contain;" />
                </a>
            </div>
        </div>

        <!-- MML & QC Details from RecLog -->
        <h6 class="text-uppercase text-muted fw-bold small mb-2">MML &amp; Quality Control Particulars</h6>
        <div class="row g-3 small mb-4">
            <div class="col-6">
                <label class="text-muted d-block">MRR Number</label>
                <span class="fw-semibold text-dark" id="recDrawerMrr">--</span>
            </div>
            <div class="col-6">
                <label class="text-muted d-block">Rec ID</label>
                <span class="badge bg-light text-dark border font-monospace" id="recDrawerRecId">--</span>
            </div>
            <div class="col-6">
                <label class="text-muted d-block">Assigned Receiver</label>
                <span class="fw-semibold text-dark" id="recDrawerReceiver">--</span>
            </div>
            <div class="col-6">
                <label class="text-muted d-block">Yard Unloader</label>
                <span class="fw-semibold text-dark" id="recDrawerUnloader">--</span>
            </div>
            <div class="col-6">
                <label class="text-muted d-block">Materials MTR Check</label>
                <span class="fw-semibold text-dark" id="recDrawerMatMtr">--</span>
                <div class="text-muted small" id="recDrawerMatMtrComm"></div>
            </div>
            <div class="col-6">
                <label class="text-muted d-block">QC MTR Check</label>
                <span class="fw-semibold text-dark" id="recDrawerQcMtr">--</span>
                <div class="text-muted small" id="recDrawerQcMtrComm"></div>
            </div>
            <div class="col-12" id="recDrawerDocLinkSection">
                <label class="text-muted d-block">Document / MRR Link</label>
                <a id="recDrawerDocLink" href="#" target="_blank" class="text-primary text-break small">
                    <i class="bi bi-box-arrow-up-right me-1"></i> Open Receiving Documents
                </a>
            </div>
        </div>

        <!-- Notes -->
        <h6 class="text-uppercase text-muted fw-bold small mb-2">Staging &amp; Driver Notes</h6>
        <div class="p-3 bg-light rounded-2 border text-muted small mb-4" id="recDrawerNotes">
            No notes specified.
        </div>

        <!-- Relocate Shipment Quick Action -->
        <div class="p-3 bg-light rounded-2 border">
            <h6 class="fw-bold small mb-2"><i class="bi bi-arrows-move me-1"></i> Relocate in Yard</h6>
            <form method="post" asp-page-handler="UpdateStaging" class="d-flex gap-2">
                <input type="hidden" name="entryId" id="recDrawerEntryId" />
                <select name="newStagingLocation" class="form-select form-select-sm">
                    <option value="Walkway">Walkway</option>
                    <option value="Bay 1 - Receiving Floor">Bay 1 - Receiving Floor</option>
                    <option value="Bay 2 - Fabrication Staging">Bay 2 - Fabrication Staging</option>
                    <option value="Yard Row A - Pipe Racks">Yard Row A - Pipe Racks</option>
                    <option value="Yard Row B - Large Equipment">Yard Row B - Large Equipment</option>
                    <option value="Quarantine / Inspection Pad">Quarantine / Inspection Pad</option>
                </select>
                <button type="submit" class="btn btn-sm btn-outline-secondary text-nowrap">Relocate</button>
            </form>
        </div>
    </div>

    <div class="p-3 border-top bg-light d-flex align-items-center justify-content-between">
        <button type="button" class="hs-btn-secondary" onclick="closeReceivingDrawer()">Close</button>
        <span class="text-muted small">Alstar Materials &amp; QC System</span>
    </div>
</div>

<!-- Modal: Materials Admin Verification Modal -->
<div class="modal fade" id="adminVerifyModal" tabindex="-1" aria-labelledby="adminVerifyModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content shadow">
            <form method="post" asp-page-handler="ApproveShipment">
                <input type="hidden" name="entryId" id="verifyEntryId" />

                <div class="modal-header bg-warning-subtle border-bottom border-warning">
                    <div>
                        <h5 class="modal-title fw-bold text-dark" id="adminVerifyModalLabel">
                            <i class="bi bi-shield-check text-warning me-2"></i>Materials Admin Verification &amp; Approval
                        </h5>
                        <div class="text-muted small">Verify PO, assign Job #, and approve shipment into receiving queue</div>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body p-4">
                    <div class="alert alert-light border d-flex align-items-center justify-content-between p-3 rounded-2 mb-3">
                        <div>
                            <span class="text-muted small d-block">Vendor:</span>
                            <span class="fw-bold fs-6" id="verifyVendor">--</span>
                        </div>
                        <div>
                            <span class="text-muted small d-block">PO Number:</span>
                            <span class="fw-bold fs-6 font-monospace text-primary" id="verifyPo">--</span>
                        </div>
                        <div>
                            <span class="text-muted small d-block">Packing Slip / BOL:</span>
                            <span class="font-monospace" id="verifySlipBol">--</span>
                        </div>
                    </div>

                    <div class="row g-3">
                        <!-- Job # Assignment (Searchable Dropdown populated from Receiving Log entries) -->
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small d-flex justify-content-between align-items-center">
                                <span>Assign Job # <span class="text-danger">*</span></span>
                                <span class="text-muted fw-normal" style="font-size: 11px;">@Model.AvailableJobs.Count jobs in Receiving Log</span>
                            </label>
                            <div class="position-relative" id="jobSearchDropdownWrapper">
                                <div class="input-group">
                                    <span class="input-group-text bg-light text-muted"><i class="bi bi-briefcase"></i></span>
                                    <input type="text" name="jobNumber" id="verifyJobInput" class="form-control font-monospace" required
                                           placeholder="Search or select Job #..." autocomplete="off" />
                                    <button class="btn btn-outline-secondary" type="button" id="jobDropdownToggleBtn" title="Toggle job list" tabindex="-1">
                                        <i class="bi bi-chevron-down" id="jobDropdownIcon"></i>
                                    </button>
                                </div>

                                <!-- Searchable Dropdown Menu -->
                                <div id="jobDropdownMenu" class="dropdown-menu shadow-sm w-100 p-0" style="max-height: 240px; overflow-y: auto; position: absolute; z-index: 1060; display: none; top: 100%; left: 0;">
                                    <div class="px-3 py-1 bg-light border-bottom text-muted small d-flex justify-content-between align-items-center sticky-top">
                                        <span>Receiving Log Jobs</span>
                                        <span id="jobMatchCount" class="badge bg-secondary-subtle text-secondary">@Model.AvailableJobs.Count</span>
                                    </div>
                                    <div id="jobOptionsList">
                                        @foreach (var job in Model.AvailableJobs)
                                        {
                                            <button type="button" class="dropdown-item d-flex align-items-center justify-content-between py-2 px-3 border-bottom border-light job-option-item"
                                                    data-job="@job.JobNumber"
                                                    data-client="@(job.ClientName ?? "")">
                                                <div>
                                                    <span class="fw-bold font-monospace text-dark job-number-text">@job.JobNumber</span>
                                                    @if (!string.IsNullOrEmpty(job.ClientName))
                                                    {
                                                        <span class="badge bg-secondary-subtle text-dark border ms-2 small job-client-text">@job.ClientName</span>
                                                    }
                                                </div>
                                                <i class="bi bi-check-lg text-primary d-none job-selected-icon"></i>
                                            </button>
                                        }
                                    </div>
                                    <div id="jobNoMatch" class="p-3 text-center text-muted small d-none">
                                        <i class="bi bi-info-circle me-1 text-primary"></i>No matching jobs found in Receiving Log.<br />
                                        <span class="text-secondary" style="font-size: 11px;">You can still keep the typed value to assign a new job.</span>
                                    </div>
                                </div>
                            </div>
                            <div class="form-text small">
                                Select from existing Receiving Log jobs or enter a new Job # to generate standard JP Key.
                            </div>
                        </div>

                        <!-- Load Type -->
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small">Confirmed Load Type</label>
                            <select name="assignedLoadType" id="verifyLoadTypeInput" class="form-select">
                                <option value="SNG / Bolt-Up">🔩 SNG / Bolt-Up (Studs, Nuts, Gaskets)</option>
                                <option value="Pipe">📏 Pipe</option>
                                <option value="Valves">🚰 Valves</option>
                                <option value="Flanges & Fittings">🔘 Flanges &amp; Fittings</option>
                                <option value="Supports">🏗️ Supports</option>
                                <option value="Electrical">⚡ Electrical</option>
                                <option value="Instrumentation">📟 Instrumentation</option>
                                <option value="General Materials">📦 General Materials / Misc</option>
                            </select>
                        </div>

                        <!-- Staging Location Confirmation -->
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small">Yard Staging Location</label>
                            <select name="stagingLocation" id="verifyStagingInput" class="form-select">
                                <option value="Walkway">📍 Walkway (Immediate Receiving Pad)</option>
                                <option value="Bay 1 - Receiving Floor">📍 Bay 1 - Receiving Floor</option>
                                <option value="Bay 2 - Fabrication Staging">📍 Bay 2 - Fabrication Staging</option>
                                <option value="Yard Row A - Pipe Racks">📍 Yard Row A - Pipe Racks</option>
                                <option value="Yard Row B - Large Equipment">📍 Yard Row B - Large Equipment</option>
                                <option value="Quarantine / Inspection Pad">📍 Quarantine / Inspection Pad</option>
                            </select>
                        </div>

                        <!-- Admin Verification Notes -->
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small">Admin Verification Notes</label>
                            <input type="text" name="adminNotes" class="form-control" placeholder="Verified with SCM / Job confirmed by PC" />
                        </div>
                    </div>
                </div>

                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success fw-bold">
                        <i class="bi bi-check-circle me-1"></i> Approve &amp; Move to Receiving Queue
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<form id="antiForgeryForm" style="display:none;">@Html.AntiForgeryToken()</form>

<!-- PHYSICAL RECEIVING INSPECTION MODAL -->
<div class="modal fade" id="inspectionModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="inspectionModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-fullscreen-lg-down modal-dialog-scrollable">
        <div class="modal-content border-0 shadow">
            <!-- Modal Header -->
            <div class="modal-header bg-dark text-white py-2 px-3">
                <div class="d-flex align-items-center gap-2 flex-wrap flex-grow-1">
                    <span class="badge bg-primary font-monospace fs-6 px-2 py-1" id="inspModalJpKey">JP Key</span>
                    <div class="flex-grow-1">
                        <h5 class="modal-title fw-bold mb-0 text-white fs-6 fs-md-5" id="inspectionModalLabel">
                            Shipment Inspection: <span id="inspModalVendor">Vendor</span>
                        </h5>
                        <div class="text-light opacity-75 small font-monospace" style="font-size: 0.8rem;">
                            PO: <span id="inspModalPo" class="fw-bold"></span> &bull; 
                            Job: <span id="inspModalJob">251078</span> &bull;
                            Slip: <span id="inspModalSlip"></span> &bull; 
                            BOL: <span id="inspModalBol"></span>
                        </div>
                    </div>
                </div>
                <!-- Top Right Status / Close -->
                <div class="d-flex align-items-center gap-2 ms-auto mt-1 mt-sm-0">
                    <span id="inspSaveBadge" class="badge bg-secondary-subtle text-secondary border px-2 py-1 small">
                        <i class="bi bi-clock me-1"></i> Ready
                    </span>
                    <button type="button" class="btn btn-sm btn-outline-light" onclick="closeInspectionModalWithSave()" title="Save progress and close">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>
            </div>

            <!-- Inspection Meta Bar -->
            <div class="bg-light border-bottom px-3 py-2">
                <div class="row g-2 align-items-center">
                    <div class="col-12 col-sm-6 col-md-3">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-person-badge text-primary fs-5"></i>
                            <div class="flex-grow-1">
                                <label class="form-label text-muted small mb-0 fw-semibold">Inspector / Receiver</label>

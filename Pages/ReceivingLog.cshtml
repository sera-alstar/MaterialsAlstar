                    return '<span class="insp-chip-pill" role="button" onclick="autofillField(' + idx + ', \'heatNumber\', \'' + safeHt + '\')" title="Autofill HT#">' + escapeHtml(ht) + '</span>';
                }).join('') +
            '</div>';
        }

        var suggestedSerials = (catEntry && catEntry.serialNumbers && catEntry.serialNumbers.length > 0)
            ? catEntry.serialNumbers
            : [];
        var serialChipsHtml = '';
        if (suggestedSerials && suggestedSerials.length > 0) {
            serialChipsHtml = '<div class="mt-1 d-flex flex-wrap gap-1 align-items-center">' +
                suggestedSerials.slice(0, 3).map(function(s) {
                    var safeSn = escapeHtml(s).replace(/'/g, "\\'");
                    return '<span class="insp-chip-pill chip-serial" role="button" onclick="autofillField(' + idx + ', \'serialNumber\', \'' + safeSn + '\')" title="Autofill Serial">' + escapeHtml(s) + '</span>';
                }).join('') +
            '</div>';
        }

        var suggestedBins = (catEntry && catEntry.binLocations && catEntry.binLocations.length > 0)
            ? catEntry.binLocations
            : ['4 D 2 2', '4D22', 'Walkway', 'Bay 1'];
        var binChipsHtml = '<div class="mt-1 d-flex flex-wrap gap-1 align-items-center">' +
            suggestedBins.slice(0, 4).map(function(b) {
                var safeB = escapeHtml(b).replace(/'/g, "\\'");
                return '<span class="insp-chip-pill chip-bin" role="button" onclick="autofillField(' + idx + ', \'storageLocation\', \'' + safeB + '\')" title="Autofill Bin">' + escapeHtml(b) + '</span>';
            }).join('') +
        '</div>';

        var cardMatchedClass = line.isDescriptionMatched ? 'is-matched' : '';
        var cardFullyRecClass = isFullyReceived ? 'is-fully-received' : '';
        var dueBadgeClass = line.quantityDue > 0 ? 'bg-primary-subtle text-primary border border-primary-subtle' : 'bg-secondary-subtle text-muted border';

        return '<div class="insp-card ' + cardMatchedClass + ' ' + cardFullyRecClass + '" id="insp_card_box_' + idx + '">' +
            // Header Bar
            '<div class="d-flex align-items-center justify-content-between mb-2">' +
                '<div class="d-flex align-items-center gap-1 flex-wrap">' +
                    '<span class="badge bg-secondary font-monospace">Line ' + escapeHtml(line.poLineNumber || (idx + 1)) + '</span>' +
                    '<span class="badge bg-light text-muted border font-monospace">' + escapeHtml(line.bomId || 'No BOM') + '</span>' +
                    (isFullyReceived ? '<span class="badge bg-secondary text-white">Fully Rec\'d</span>' : '') +
                    (line.isAdHoc ? '<span class="badge bg-warning-subtle text-dark border border-warning">Extra Item</span>' : '') +
                '</div>' +
                '<div class="d-flex align-items-center gap-1">' +
                    '<span class="badge bg-light text-dark border">' + escapeHtml(line.unitOfMeasure || 'EA') + '</span>' +
                    (line.isAdHoc ? '<button type="button" class="btn btn-sm btn-link text-danger p-0 ms-1" onclick="removeAdHocLine(' + idx + ')" title="Remove item"><i class="bi bi-trash fs-6"></i></button>' : '') +
                '</div>' +
            '</div>' +

            // Non-truncated Item Description (Clear Physical Context)
            '<div class="fw-bold text-dark fs-6 mb-2">' + escapeHtml(line.itemDescription || '') + '</div>' +

            // Counts & Match Row
            '<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 p-2 bg-light rounded-2 border mb-2">' +
                '<div class="d-flex align-items-center gap-2 small flex-wrap">' +
                    '<span class="badge bg-white text-muted border">Ord: <strong class="text-dark">' + line.quantityOrdered + '</strong></span>' +
                    '<span class="badge bg-white text-muted border">Prev: <strong class="text-dark">' + line.quantityPreviouslyReceived + '</strong></span>' +
                    '<span class="badge ' + dueBadgeClass + '">Due: <strong>' + line.quantityDue + '</strong></span>' +
                '</div>' +
                '<div class="form-check form-switch m-0">' +
                    '<input class="form-check-input" type="checkbox" role="switch" id="insp_card_isDescriptionMatched_' + idx + '" ' +
                        (line.isDescriptionMatched ? 'checked' : '') +
                        ' onchange="updateLineField(' + idx + ', \'isDescriptionMatched\', this.checked)">' +
                    '<label class="form-check-label small fw-bold" for="insp_card_isDescriptionMatched_' + idx + '">Matches Item</label>' +
                '</div>' +
            '</div>' +

            // Qty Rec'd Stepper
            '<div class="d-flex align-items-center gap-2 mb-3">' +
                '<label class="small fw-bold text-muted mb-0">Qty Rec\'d:</label>' +
                '<div class="input-group input-group-sm insp-qty-stepper" style="max-width: 160px;">' +
                    '<button class="btn btn-outline-secondary" type="button" onclick="stepQty(' + idx + ', -1)" title="Decrease">-</button>' +
                    '<input type="number" min="0" step="any" class="form-control text-center fw-bold font-monospace" ' +
                        'id="insp_card_quantityReceivedThisShipment_' + idx + '" ' +
                        'value="' + (line.quantityReceivedThisShipment || 0) + '" ' +
                        'oninput="updateLineField(' + idx + ', \'quantityReceivedThisShipment\', parseFloat(this.value) || 0)">' +
                    '<button class="btn btn-outline-secondary" type="button" onclick="stepQty(' + idx + ', 1)" title="Increase">+</button>' +
                '</div>' +
                '<button type="button" class="btn btn-sm btn-outline-primary fw-semibold px-2" onclick="fillDueQty(' + idx + ', ' + line.quantityDue + ')" title="Receive all due (' + line.quantityDue + ')">' +
                    'All (' + line.quantityDue + ')' +
                '</button>' +
            '</div>' +

            // Traceability Fields Grid (Heat #, Storage Bin, Serial #, Notes)
            '<div class="row g-2 mb-1">' +
                // Heat #
                '<div class="col-12 col-sm-6">' +
                    '<label class="form-label small text-muted mb-0 fw-semibold" style="font-size: 11px;">Heat # (HT#)</label>' +
                    '<input type="text" class="form-control form-control-sm font-monospace" list="dl_all_heat_numbers" ' +
                        'id="insp_card_heatNumber_' + idx + '" ' +
                        'placeholder="Enter or tap HT#" value="' + escapeHtml(line.heatNumber || '') + '" ' +
                        'oninput="updateLineField(' + idx + ', \'heatNumber\', this.value)" />' +
                    htChipsHtml +
                '</div>' +
                // Bin Location
                '<div class="col-12 col-sm-6">' +
                    '<label class="form-label small text-muted mb-0 fw-semibold" style="font-size: 11px;">Storage Location (Bin)</label>' +
                    '<input type="text" class="form-control form-control-sm font-monospace" list="dl_all_bin_locations" ' +
                        'id="insp_card_storageLocation_' + idx + '" ' +
                        'placeholder="e.g. 4 D 2 2" value="' + escapeHtml(line.storageLocation || '') + '" ' +
                        'oninput="updateLineField(' + idx + ', \'storageLocation\', this.value)" />' +
                    binChipsHtml +
                '</div>' +
                // Serial / Tag #
                '<div class="col-12 col-sm-6">' +
                    '<label class="form-label small text-muted mb-0 fw-semibold" style="font-size: 11px;">Serial / Tag #</label>' +
                    '<input type="text" class="form-control form-control-sm font-monospace" list="dl_all_serial_numbers" ' +
                        'id="insp_card_serialNumber_' + idx + '" ' +
                        'placeholder="Serial / Tag #" value="' + escapeHtml(line.serialNumber || '') + '" ' +
                        'oninput="updateLineField(' + idx + ', \'serialNumber\', this.value)" />' +
                    serialChipsHtml +
                '</div>' +
                // Line Notes
                '<div class="col-12 col-sm-6">' +
                    '<label class="form-label small text-muted mb-0 fw-semibold" style="font-size: 11px;">Line Notes / Discrepancy</label>' +
                    '<input type="text" class="form-control form-control-sm" ' +
                        'id="insp_card_notes_' + idx + '" ' +
                        'placeholder="Line notes..." value="' + escapeHtml(line.notes || '') + '" ' +
                        'oninput="updateLineField(' + idx + ', \'notes\', this.value)" />' +
                '</div>' +
            '</div>' +
        '</div>';
    }

    function filterInspectionTable() {
        renderInspectionLines();
    }

    function stepQty(idx, delta) {
        if (!window.currentInspectionLines || !window.currentInspectionLines[idx]) return;
        var current = parseFloat(window.currentInspectionLines[idx].quantityReceivedThisShipment) || 0;
        var next = Math.max(0, current + delta);
        updateLineField(idx, 'quantityReceivedThisShipment', next);
    }

    function updateLineField(idx, field, value) {
        if (!window.currentInspectionLines || !window.currentInspectionLines[idx]) return;
        window.currentInspectionLines[idx][field] = value;

        // Synchronize Table Input (if present)
        var tableEl = document.getElementById('insp_line_' + field + '_' + idx);
        if (tableEl) {
            if (tableEl.type === 'checkbox') {
                tableEl.checked = !!value;
            } else if (tableEl.value !== String(value)) {
                tableEl.value = value;
            }
        }

        // Synchronize Mobile Card Input (if present)
        var cardEl = document.getElementById('insp_card_' + field + '_' + idx);
        if (cardEl) {
            if (cardEl.type === 'checkbox') {
                cardEl.checked = !!value;
            } else if (cardEl.value !== String(value)) {
                cardEl.value = value;
            }
        }

        // Toggle Visual Accent on Card Box
        if (field === 'isDescriptionMatched') {
            var cardBox = document.getElementById('insp_card_box_' + idx);
            if (cardBox) {
                if (value) cardBox.classList.add('is-matched');
                else cardBox.classList.remove('is-matched');
            }
        }

        if (field === 'quantityReceivedThisShipment') {
            updateSummaryMetrics();
        }

        triggerDebouncedSave();
    }

    function autofillField(idx, field, value) {
        if (!window.currentInspectionLines || !window.currentInspectionLines[idx]) return;
        updateLineField(idx, field, value);

        var tableEl = document.getElementById('insp_line_' + field + '_' + idx);
        if (tableEl) {
            tableEl.classList.add('bg-success-subtle');
            setTimeout(function() { tableEl.classList.remove('bg-success-subtle'); }, 600);
        }

        var cardEl = document.getElementById('insp_card_' + field + '_' + idx);
        if (cardEl) {
            cardEl.classList.add('bg-success-subtle');
            setTimeout(function() { cardEl.classList.remove('bg-success-subtle'); }, 600);
        }
    }

    function fillDueQty(idx, qty) {
        if (!window.currentInspectionLines || !window.currentInspectionLines[idx]) return;
        var fillVal = qty !== undefined && qty !== null ? qty : (window.currentInspectionLines[idx].quantityDue || 0);

        updateLineField(idx, 'quantityReceivedThisShipment', fillVal);
        updateLineField(idx, 'isDescriptionMatched', true);

        var tableQtyEl = document.getElementById('insp_line_quantityReceivedThisShipment_' + idx);
        if (tableQtyEl) {
            tableQtyEl.classList.add('bg-primary-subtle');
            setTimeout(function() { tableQtyEl.classList.remove('bg-primary-subtle'); }, 600);
        }

        var cardQtyEl = document.getElementById('insp_card_quantityReceivedThisShipment_' + idx);
        if (cardQtyEl) {
            cardQtyEl.classList.add('bg-primary-subtle');
            setTimeout(function() { cardQtyEl.classList.remove('bg-primary-subtle'); }, 600);
        }
    }

    function addAdHocInspectionLine() {
        var staging = document.getElementById('inspStaging')?.innerText?.replace('📍 ', '').trim() || 'Walkway';
        var newLine = {
            id: 0,
            receivingLogEntryId: window.currentInspectionEntryId,
            jpKey: document.getElementById('inspModalJpKey')?.innerText || '',
            poNumber: document.getElementById('inspModalPo')?.innerText || '',
            poLineNumber: 'EXTRA-' + (window.currentInspectionLines.length + 1),
            bomId: '',
            itemDescription: 'Extra Unlisted Material',
            quantityOrdered: 0,
            quantityPreviouslyReceived: 0,
            quantityDue: 0,
            quantityReceivedThisShipment: 1,
            unitOfMeasure: 'EA',
            isDescriptionMatched: true,
            heatNumber: '',
            serialNumber: '',
            storageLocation: staging,
            notes: 'Unlisted on VISTA BOM',
            isAdHoc: true
        };

        window.currentInspectionLines.push(newLine);
        renderInspectionLines();
        triggerDebouncedSave();
    }

    function removeAdHocLine(idx) {
        if (!window.currentInspectionLines || !window.currentInspectionLines[idx]) return;
        window.currentInspectionLines.splice(idx, 1);
        renderInspectionLines();
        triggerDebouncedSave();
    }

    function updateSummaryMetrics() {
        if (!window.currentInspectionLines) return;
        var totalLines = window.currentInspectionLines.length;
        var countedLines = 0;
        var totalPieces = 0;

        window.currentInspectionLines.forEach(function(l) {
            var rec = parseFloat(l.quantityReceivedThisShipment) || 0;
            if (rec > 0) countedLines++;
            totalPieces += rec;
        });

        var elTotal = document.getElementById('inspTotalLinesCount');
        var elCounted = document.getElementById('inspCountedLinesCount');
        var elPieces = document.getElementById('inspTotalPiecesCount');

        if (elTotal) elTotal.innerText = totalLines;
        if (elCounted) elCounted.innerText = countedLines;
        if (elPieces) elPieces.innerText = totalPieces.toLocaleString();
    }

    function triggerDebouncedSave() {
        var badge = document.getElementById('inspSaveBadge');
        if (badge) {
            badge.className = 'badge bg-warning-subtle text-dark border px-2 py-1 small';
            badge.innerHTML = '<i class="bi bi-arrow-repeat spin me-1"></i> Saving draft...';
        }

        // Local mirror save
        try {
            var draftPayload = {
                lines: window.currentInspectionLines,
                notes: document.getElementById('inspOverallNotes')?.value || '',
                receiver: document.getElementById('inspReceiverName')?.value || '',
                timestamp: new Date().toISOString()
            };
            localStorage.setItem('alstar_insp_draft_' + window.currentInspectionEntryId, JSON.stringify(draftPayload));
        } catch (e) { }

        clearTimeout(window.saveTimeout);
        window.saveTimeout = setTimeout(function() {
            saveDraftToServer();
        }, 1200);
    }

    function saveDraftToServer(callback) {
        if (!window.currentInspectionEntryId) return;

        var payload = {
            entryId: window.currentInspectionEntryId,
            receiverName: document.getElementById('inspReceiverName')?.value || '',
            inspectionNotes: document.getElementById('inspOverallNotes')?.value || '',
            lines: window.currentInspectionLines
        };

        fetch('/ReceivingLog?handler=SaveInspectionDraft', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': getAntiForgeryToken()
            },
            body: JSON.stringify(payload)
        })
        .then(function(res) {
            if (!res.ok) throw new Error('HTTP ' + res.status);
            return res.json();
        })
        .then(function(data) {
            var badge = document.getElementById('inspSaveBadge');
            if (badge) {
                badge.className = 'badge bg-success-subtle text-success border px-2 py-1 small';
                badge.innerHTML = '<i class="bi bi-check2-circle me-1"></i> Auto-saved at ' + (data.savedAt || new Date().toLocaleTimeString());
            }
            if (callback) callback();
        })
        .catch(function(err) {
            console.warn('Draft save error:', err);
            var badge = document.getElementById('inspSaveBadge');
            if (badge) {
                badge.className = 'badge bg-secondary-subtle text-dark border px-2 py-1 small';
                badge.innerHTML = '<i class="bi bi-hdd me-1"></i> Saved locally';
            }
            if (callback) callback();
        });
    }

    function closeInspectionModalWithSave() {
        saveDraftToServer(function() {
            if (window.inspectionModalInstance) {
                window.inspectionModalInstance.hide();
            }
        });
        setTimeout(function() {
            if (window.inspectionModalInstance) {
                window.inspectionModalInstance.hide();
            }
        }, 400);
    }

    function submitInspectionForAdmin() {
        var inspector = (document.getElementById('inspReceiverName')?.value || '').trim();
        if (!inspector) {
            alert('Please specify the Inspector / Receiver name before submitting.');
            document.getElementById('inspReceiverName')?.focus();
            return;
        }

        var totalRec = window.currentInspectionLines.reduce(function(sum, l) {
            return sum + (parseFloat(l.quantityReceivedThisShipment) || 0);
        }, 0);

        if (totalRec <= 0) {
            if (!confirm('No items have a received quantity greater than 0. Do you want to submit this inspection report as empty / non-received?')) {
                return;
            }
        }

        var payload = {
            entryId: window.currentInspectionEntryId,
            receiverName: inspector,
            inspectionNotes: document.getElementById('inspOverallNotes')?.value || '',
            lines: window.currentInspectionLines
        };

        var submitBtn = event ? event.target.closest('button') : null;
        if (submitBtn) {
            submitBtn.disabled = true;
            submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Submitting to Admin...';
        }

        fetch('/ReceivingLog?handler=SubmitInspection', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': getAntiForgeryToken()
            },
            body: JSON.stringify(payload)
        })
        .then(function(res) {
            if (!res.ok) throw new Error('HTTP ' + res.status);
            return res.json();
        })
        .then(function(data) {
            try {
                localStorage.removeItem('alstar_insp_draft_' + window.currentInspectionEntryId);
            } catch (e) { }

            if (data.redirectUrl) {
                window.location.href = data.redirectUrl;
            } else {
                window.location.reload();
            }
        })
        .catch(function(err) {
            console.error(err);
            alert('Error submitting inspection report. Please check server logs.');
            if (submitBtn) {
                submitBtn.disabled = false;
                submitBtn.innerHTML = '<i class="bi bi-send-check me-1"></i> Submit Inspection for Admin Approval';
            }
        });
    }


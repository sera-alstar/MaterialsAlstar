@page
@model IndexModel
@{
    ViewData["Title"] = "Materials Inventory";
}

<div class="container py-4">
    <div class="row align-items-center mb-4">
        <div class="col">
            <h1 class="display-6 fw-bold">📦 Materials Inventory</h1>
            <p class="text-muted mb-0">Running in local test mode with Entity Framework Core (In-Memory Data)</p>
        </div>
        <div class="col-auto">
            <span class="badge bg-success text-white px-3 py-2">
                ● Local Test Mode Active
            </span>
        </div>
    </div>

    <!-- Frontend JavaScript Search Bar -->
    <div class="card mb-4 shadow-sm border-0 bg-light">
        <div class="card-body">
            <div class="row g-2 align-items-center">
                <div class="col-md-6">
                    <label for="materialSearch" class="form-label visually-hidden">Search materials</label>
                    <input type="text" id="materialSearch" class="form-control" placeholder="🔍 Filter materials by name, SKU, or category...">
                </div>
                <div class="col-md-6 text-md-end text-muted small">
                    Showing <span id="visibleCount" class="fw-semibold">@Model.Materials.Count</span> of @Model.Materials.Count items
                </div>
            </div>
        </div>
    </div>

    <!-- Materials Table -->
    <div class="card shadow-sm border-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="materialsTable">
                <thead class="table-light">
                    <tr>
                        <th>#</th>
                        <th>Name</th>
                        <th>SKU</th>
                        <th>Category</th>
                        <th class="text-end">Quantity</th>
                        <th class="text-end">Unit Cost</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Materials)
                    {
                        <tr class="material-row">
                            <td class="text-muted">@item.Id</td>
                            <td class="fw-semibold material-name">@item.Name</td>
                            <td><span class="badge bg-secondary text-white material-sku">@item.Sku</span></td>
                            <td><span class="badge bg-primary text-white material-category">@item.Category</span></td>
                            <td class="text-end fw-semibold">@item.Quantity <span class="text-muted small">@item.Unit</span></td>
                            <td class="text-end">@item.UnitCost.ToString("C")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

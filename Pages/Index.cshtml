@page
@model IndexModel
@{
    ViewData["Title"] = "Materials & QC Receiving";
}

<div class="container-fluid px-4 py-4">
    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h1 class="h3 fw-bold mb-1">🏗️ Alstar Materials Receiving &amp; QC Tracker</h1>
            <p class="text-muted small mb-0">Quality Control material receiving, Heat Number tracking, and warehouse bin allocation.</p>
        </div>
        <div class="mt-2 mt-md-0">
            <span class="badge bg-success-subtle text-success border border-success px-3 py-2 fs-6">
                ● EF Core Local Test Mode Active
            </span>
        </div>
    </div>

    <!-- Stats Cards -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-4 col-lg-2">
            <div class="card shadow-sm border-0 bg-white">
                <div class="card-body p-3">
                    <div class="text-muted small text-uppercase fw-semibold">Line Items</div>
                    <div class="fs-4 fw-bold text-dark mt-1">@Model.TotalItems</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-4 col-lg-2">
            <div class="card shadow-sm border-0 bg-white">
                <div class="card-body p-3">
                    <div class="text-muted small text-uppercase fw-semibold">Units Recv'd</div>
                    <div class="fs-4 fw-bold text-success mt-1">@Model.TotalQuantityReceived.ToString("0")</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-4 col-lg-2">
            <div class="card shadow-sm border-0 bg-white">
                <div class="card-body p-3">
                    <div class="text-muted small text-uppercase fw-semibold">Active Jobs</div>
                    <div class="fs-4 fw-bold text-primary mt-1">@Model.UniqueJobsCount</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-4 col-lg-3">
            <div class="card shadow-sm border-0 bg-white">
                <div class="card-body p-3">
                    <div class="text-muted small text-uppercase fw-semibold">Heat Numbers (MTRs)</div>
                    <div class="fs-4 fw-bold text-danger mt-1">@Model.UniqueHeatNumbersCount</div>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-4 col-lg-3">
            <div class="card shadow-sm border-0 bg-white">
                <div class="card-body p-3">
                    <div class="text-muted small text-uppercase fw-semibold">Bin Locations</div>
                    <div class="fs-4 fw-bold text-info mt-1">@Model.UniqueBinsCount</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Filter & Search Controls -->
    <div class="card shadow-sm border-0 mb-4 bg-light">
        <div class="card-body p-3">
            <div class="row g-2 align-items-center">
                <!-- Search Box -->
                <div class="col-md-6 col-lg-5">
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0">🔍</span>
                        <input type="text" id="searchInput" class="form-control border-start-0" placeholder="Search Job #, PO #, BOMID, Heat #, Bin, or Description...">
                    </div>
                </div>

                <!-- Job Filter -->
                <div class="col-6 col-md-3 col-lg-2">
                    <select id="jobFilter" class="form-select">
                        <option value="">All Jobs</option>
                        @foreach (var job in Model.JobOptions)
                        {
                            <option value="@job">Job @job</option>
                        }
                    </select>
                </div>

                <!-- Bin Filter -->
                <div class="col-6 col-md-3 col-lg-2">
                    <select id="binFilter" class="form-select">
                        <option value="">All Bins</option>
                        @foreach (var bin in Model.BinOptions)
                        {
                            <option value="@bin">Bin @bin</option>
                        }
                    </select>
                </div>

                <!-- Reset Button & Live Count -->
                <div class="col-12 col-lg-3 d-flex align-items-center justify-content-between justify-content-lg-end gap-2">
                    <button id="resetFilters" class="btn btn-outline-secondary btn-sm" type="button">Reset</button>
                    <span class="text-muted small">
                        Showing <strong id="visibleCount" class="text-dark">@Model.TotalItems</strong> of @Model.TotalItems items
                    </span>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Table -->
    <div class="card shadow-sm border-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="materialsTable">
                <thead class="table-dark">
                    <tr class="small text-uppercase">
                        <th style="min-width: 90px;">Job #</th>
                        <th style="min-width: 140px;">PO # / Receiver</th>
                        <th style="min-width: 140px;">BOMID</th>
                        <th style="min-width: 250px;">Material Description &amp; Vendor</th>
                        <th class="text-center" style="min-width: 100px;">Qty (Recv/Ship)</th>
                        <th style="min-width: 130px;">Heat # (MTR)</th>
                        <th style="min-width: 110px;">Bin Location</th>
                        <th style="min-width: 140px;">Received By</th>
                        <th class="text-center" style="min-width: 90px;">Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Materials)
                    {
                        <tr class="material-row"
                            data-job="@item.JobNumber"
                            data-po="@item.PoNumber"
                            data-receiver="@item.ReceiverId"
                            data-bomid="@item.BomId"
                            data-desc="@item.Description"
                            data-vendor="@item.VendorName"
                            data-heat="@item.HeatNumber"
                            data-bin="@item.BinLocation">
                            
                            <!-- Job # -->
                            <td>
                                <span class="badge bg-primary fs-6 font-monospace">@item.JobNumber</span>
                            </td>

                            <!-- PO # and Receiver ID -->
                            <td>
                                <div class="fw-bold text-dark font-monospace">@item.PoNumber</div>
                                <div class="text-muted small">Rec: <span class="badge bg-light text-dark border">@item.ReceiverId</span></div>
                            </td>

                            <!-- BOMID -->
                            <td>
                                <span class="badge bg-dark-subtle text-dark border font-monospace">@item.BomId</span>
                            </td>

                            <!-- Material Description & Vendor -->
                            <td>
                                <div class="fw-semibold text-dark">@item.Description</div>
                                <div class="text-muted small">🏢 @item.VendorName</div>
                            </td>

                            <!-- Quantity Received vs Shipped -->
                            <td class="text-center">
                                <span class="fw-bold text-success fs-6">@item.QuantityReceived.ToString("0")</span>
                                <span class="text-muted small">/ @item.QuantityShipped.ToString("0") @item.Unit</span>
                            </td>

                            <!-- Heat # -->
                            <td>
                                <span class="badge bg-danger text-white font-monospace px-2 py-1">
                                    🔥 @item.HeatNumber
                                </span>
                            </td>

                            <!-- Bin Location -->
                            <td>
                                <span class="badge bg-info-subtle text-info-emphasis border border-info font-monospace px-2 py-1">
                                    📦 @item.BinLocation
                                </span>
                            </td>

                            <!-- Received By & Date -->
                            <td>
                                <div class="fw-semibold small">@item.ReceivedBy</div>
                                <div class="text-muted small">@(item.ReceivedDate?.ToString("MMM dd, yyyy") ?? "-")</div>
                            </td>

                            <!-- Status -->
                            <td class="text-center">
                                <span class="badge bg-success-subtle text-success border border-success">
                                    ✓ @item.Status
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function clearBolSearch() {
            var input = document.getElementById('bolSearchInput');
            if (input) {
                input.value = '';
                document.getElementById('bolFilterForm').submit();
            }
        }

        function prepareNewBolModal() {
            var dateInput = document.getElementById('newBolDateCreatedDisplay');
            if (dateInput) {
                var now = new Date();
                dateInput.value = now.toLocaleDateString('en-US', {
                    year: 'numeric', month: 'short', day: 'numeric',
                    hour: '2-digit', minute: '2-digit'
                });
            }
            updatePriorityPreview();
        }

        function openEditBolModal(btn) {
            if (!btn) return;
            var bolId = btn.getAttribute('data-bol-id') || '';
            var bolNumber = btn.getAttribute('data-bol-number') || '';
            var jobNumber = btn.getAttribute('data-job-number') || '';
            var shipFrom = btn.getAttribute('data-ship-from') || '';
            var shipTo = btn.getAttribute('data-ship-to') || '';
            var batchId = btn.getAttribute('data-batch-id') || '0';
            var priorities = btn.getAttribute('data-priorities') || '';
            var type = btn.getAttribute('data-type') || 'Shiploose';
            var kitter = btn.getAttribute('data-kitter') || '';
            var palletCount = btn.getAttribute('data-pallet-count') || '0';
            var crateCount = btn.getAttribute('data-crate-count') || '0';
            var dateCreated = btn.getAttribute('data-date-created') || '';
            var notes = btn.getAttribute('data-notes') || '';

            document.getElementById('editBolId').value = bolId;
            document.getElementById('editBolNumberHidden').value = bolNumber;
            document.getElementById('editBolHeaderNumber').innerText = bolNumber;
            document.getElementById('editBolNumberDisplay').value = bolNumber;
            document.getElementById('editBolDateCreatedDisplay').value = dateCreated;

            document.getElementById('editBolShipFrom').value = shipFrom;
            document.getElementById('editBolShipTo').value = shipTo;
            document.getElementById('editBolJobNumber').value = jobNumber;
            document.getElementById('editBolBatchId').value = batchId;
            document.getElementById('editBolType').value = (type.toLowerCase() === 'assembly') ? 'Assembly' : 'Shiploose';
            document.getElementById('editBolPriorities').value = priorities;
            document.getElementById('editBolKitter').value = kitter;
            document.getElementById('editBolPalletCount').value = palletCount;
            document.getElementById('editBolCrateCount').value = crateCount;
            document.getElementById('editBolNotes').value = notes;

            updateEditPriorityPreview();

            var modal = new bootstrap.Modal(document.getElementById('editBolModal'));
            modal.show();
        }

        function updateEditPriorityPreview() {
            var input = document.getElementById('editBolPriorities');
            var container = document.getElementById('editPriorityPreviewBadges');
            if (!input || !container) return;

            var tokens = input.value.split(/[,;]+/).map(function(t) { return t.trim(); }).filter(Boolean);
            container.innerHTML = tokens.map(function(t) {
                var isValid = /^\d+$/.test(t) || /^\d+\s*-\s*\d+$/.test(t);
                var cls = isValid
                    ? 'bg-primary-subtle text-primary border border-primary-subtle'
                    : 'bg-danger-subtle text-danger border border-danger-subtle';
                return '<span class="badge ' + cls + ' font-monospace">P:' + t.replace(/\s+/g, '') + '</span>';
            }).join('');
        }

        function updatePriorityPreview() {
            var input = document.getElementById('newBolPriorities');
            var container = document.getElementById('priorityPreviewBadges');
            if (!input || !container) return;

            var tokens = input.value.split(/[,;]+/).map(function(t) { return t.trim(); }).filter(Boolean);
            container.innerHTML = tokens.map(function(t) {
                var isValid = /^\d+$/.test(t) || /^\d+\s*-\s*\d+$/.test(t);
                var cls = isValid
                    ? 'bg-primary-subtle text-primary border border-primary-subtle'
                    : 'bg-danger-subtle text-danger border border-danger-subtle';
                return '<span class="badge ' + cls + ' font-monospace">P:' + t.replace(/\s+/g, '') + '</span>';
            }).join('');
        }

        function exportBolsToCsv() {
            var table = document.getElementById('bolTable');
            if (!table) return;
            var rows = Array.from(table.querySelectorAll('tr'));
            var csv = rows.map(function(row) {
                var cells = Array.from(row.querySelectorAll('th, td'));
                return cells.map(function(c) {
                    var text = (c.innerText || '').replace(/\r?\n|\r/g, ' ').trim().replace(/"/g, '""');
                    return '"' + text + '"';
                }).join(',');
            }).join('\n');

            var blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
            var url = URL.createObjectURL(blob);
            var a = document.createElement('a');
            a.href = url;
            a.download = 'BillsOfLading_' + new Date().toISOString().slice(0, 10) + '.csv';
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
        }

        function escapePrintHtml(str) {
            return String(str == null ? '' : str)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;');
        }

        function formatPrintTimestamp(d) {
            var yyyy = d.getFullYear();
            var mm = String(d.getMonth() + 1).padStart(2, '0');
            var dd = String(d.getDate()).padStart(2, '0');
            var hh = String(d.getHours()).padStart(2, '0');
            var min = String(d.getMinutes()).padStart(2, '0');
            return yyyy + '-' + mm + '-' + dd + ' ' + hh + ':' + min;
        }

        function printBolPdf(btn) {
            if (!btn) return;
            var bolNumber = btn.getAttribute('data-bol-number') || '';
            var jobNumber = btn.getAttribute('data-job-number') || '';
            var shipFrom = btn.getAttribute('data-ship-from') || 'Alstar Group - Calgary Fab Shop\n8700 Venture Ave\nCalgary, AB T3S 0A2';
            var shipTo = btn.getAttribute('data-ship-to') || 'Cenovus';
            var batchId = btn.getAttribute('data-batch-id') || '';
            var priorities = (btn.getAttribute('data-priorities') || '').replace(/\s+/g, '');
            var type = btn.getAttribute('data-type') || 'Shiploose';
            var kitter = btn.getAttribute('data-kitter') || '';
            var palletCount = parseInt(btn.getAttribute('data-pallet-count') || '0', 10) || 0;
            var crateCount = parseInt(btn.getAttribute('data-crate-count') || '0', 10) || 0;
            var dateCreated = btn.getAttribute('data-date-created') || formatPrintTimestamp(new Date());
            var notes = btn.getAttribute('data-notes') || '';

            var datePrinted = formatPrintTimestamp(new Date());
            var clientName = (shipTo.split(/\r?\n/)[0] || shipTo).trim();
            var clientProject = (priorities ? (priorities + ' - ') : '') + type;
            var totalPages = 1 + crateCount + palletCount;
            var palletCrateSummary = palletCount + ' Pallet(s) / ' + crateCount + ' Crate(s)';

            // Build Crate & Pallet pages matching Pages 2+ of the reference PDF (without inventory table)
            var unitPagesHtml = '';

            for (var c = 1; c <= crateCount; c++) {
                var crateLabel = crateCount > 1 ? ('CRATE (' + c + ' of ' + crateCount + ')') : 'CRATE';
                unitPagesHtml +=
                    '<div class="pdf-page page-break">' +
                        '<div class="unit-top-banner">' +
                            '<div class="unit-job-title">JOB: ' + escapePrintHtml(jobNumber) + ' &nbsp;|&nbsp; ' + escapePrintHtml(type.toUpperCase()) + '</div>' +
                            '<div class="unit-priority-box">' +
                                '<div class="unit-priority-label">PRIORITY:</div>' +
                                '<div class="unit-priority-val">' + escapePrintHtml(priorities || '-') + '</div>' +
                            '</div>' +
                        '</div>' +
                        '<div class="unit-sub-banner">' +
                            '<div>' +
                                '<div class="unit-sub-label">PALLET / CRATE:</div>' +
                                '<div class="unit-sub-val">' + escapePrintHtml(crateLabel) + '</div>' +
                            '</div>' +
                            '<div class="unit-by-val">BY: ' + escapePrintHtml(kitter) + '</div>' +
                        '</div>' +
                        '<div class="unit-desc-row">DESC: ' + escapePrintHtml(notes || '-') + '</div>' +
                    '</div>';
            }

            for (var p = 1; p <= palletCount; p++) {
                var palletLabel = palletCount > 1 ? ('PALLET (' + p + ' of ' + palletCount + ')') : 'PALLET';
                unitPagesHtml +=
                    '<div class="pdf-page page-break">' +
                        '<div class="unit-top-banner">' +
                            '<div class="unit-job-title">JOB: ' + escapePrintHtml(jobNumber) + ' &nbsp;|&nbsp; ' + escapePrintHtml(type.toUpperCase()) + '</div>' +
                            '<div class="unit-priority-box">' +
                                '<div class="unit-priority-label">PRIORITY:</div>' +
                                '<div class="unit-priority-val">' + escapePrintHtml(priorities || '-') + '</div>' +
                            '</div>' +
                        '</div>' +
                        '<div class="unit-sub-banner">' +
                            '<div>' +
                                '<div class="unit-sub-label">PALLET / CRATE:</div>' +
                                '<div class="unit-sub-val">' + escapePrintHtml(palletLabel) + '</div>' +
                            '</div>' +
                            '<div class="unit-by-val">BY: ' + escapePrintHtml(kitter) + '</div>' +
                        '</div>' +
                        '<div class="unit-desc-row">DESC: ' + escapePrintHtml(notes || '-') + '</div>' +
                    '</div>';
            }

            var html = '<!DOCTYPE html><html><head><meta charset="utf-8" />' +
                '<title>Bill of Lading - ' + escapePrintHtml(bolNumber) + '</title>' +
                '<style>' +
                    '@@page { size: letter portrait; margin: 0.45in; }' +
                    '* { box-sizing: border-box; -webkit-print-color-adjust: exact !important; print-color-adjust: exact !important; }' +
                    'body { font-family: Arial, Helvetica, sans-serif; color: #000; margin: 0; padding: 0; font-size: 12px; }' +
                    '.pdf-page { width: 100%; }' +
                    '.page-break { page-break-before: always; break-before: page; }' +
                    '.bol-header-banner { background: #000; color: #fff; text-align: center; font-size: 22px; font-weight: 700; padding: 12px 16px; margin-bottom: 14px; }' +
                    'table.bol-grid { width: 100%; border-collapse: collapse; margin-bottom: 12px; }' +
                    'table.bol-grid th, table.bol-grid td { border: 1px solid #999; padding: 6px 8px; vertical-align: top; text-align: left; }' +
                    '.ship-header { font-size: 14px; font-weight: 700; background: #fff; }' +
                    '.ship-body { font-size: 13px; white-space: pre-line; min-height: 64px; line-height: 1.35; }' +
                    '.legal-box { border: 1px solid #999; background: #f2f2f2; padding: 8px 10px; margin-bottom: 12px; }' +
                    '.legal-title { font-weight: 700; font-size: 10.5px; margin-bottom: 4px; }' +
                    '.legal-text { font-size: 8.5px; line-height: 1.28; color: #111; }' +
                    '.copy-table th { background: #efefef; font-size: 11px; font-weight: 700; }' +
                    '.copy-table td { font-size: 11.5px; }' +
                    '.reg-table td { font-size: 12px; padding: 7px 8px; }' +
                    '.meta-table td { font-size: 12px; padding: 5px 8px; }' +
                    '.meta-label { font-weight: 700; width: 18%; background: #fff; }' +
                    '.meta-val { width: 32%; }' +
                    '.notice-line { font-weight: 700; font-size: 10.5px; margin: 12px 0 8px 0; }' +
                    '.unit-top-banner { background: #000; color: #fff; display: flex; align-items: center; justify-content: space-between; padding: 10px 14px; margin-bottom: 8px; }' +
                    '.unit-job-title { font-size: 18px; font-weight: 700; }' +
                    '.unit-priority-box { text-align: right; }' +
                    '.unit-priority-label { font-size: 10px; text-transform: uppercase; opacity: 0.9; }' +

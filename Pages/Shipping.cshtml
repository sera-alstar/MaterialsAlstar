                    '.unit-sub-banner { background: #efefef; display: flex; align-items: flex-start; justify-content: space-between; padding: 10px 14px; margin-bottom: 10px; }' +
                    '.unit-sub-label { font-size: 10px; color: #333; text-transform: uppercase; }' +
                    '.unit-sub-val { font-size: 16px; font-weight: 700; margin-top: 2px; }' +
                    '.unit-by-val { font-size: 14px; font-weight: 700; }' +
                    '.unit-desc-row { font-size: 11px; font-weight: 700; margin-bottom: 6px; }' +
                '</style>' +
                '</head><body>' +
                '<!-- PAGE 1: Main Bill of Lading -->' +
                '<div class="pdf-page">' +
                    '<div class="bol-header-banner">Bill of Lading - ' + escapePrintHtml(bolNumber) + '</div>' +
                    '<table class="bol-grid">' +
                        '<tr>' +
                            '<th class="ship-header" style="width: 50%;">Ship From:</th>' +
                            '<th class="ship-header" style="width: 50%;">Ship To:</th>' +
                        '</tr>' +
                        '<tr>' +
                            '<td class="ship-body">' + escapePrintHtml(shipFrom) + '</td>' +
                            '<td class="ship-body">' + escapePrintHtml(shipTo) + '</td>' +
                        '</tr>' +
                    '</table>' +
                    '<div class="legal-box">' +
